rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email ==
           get(/databases/$(database)/documents/config/access).data.allowedEmail;
    }

    match /config/access {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /songs/{songId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.keys().hasAll(['nombre', 'artista', 'ownerUid', 'letra', 'versiones']);

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
